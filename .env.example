# Copy to .env and fill in. Never commit .env.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ── Database (Supabase Postgres) ─────────────────────
# Pooled connection, transaction mode (port 6543): used by the API at runtime
DATABASE_URL=
# Direct connection (port 5432): used only for migrations and backups.
# db.<project>.supabase.co is IPv6-only. On IPv4-only networks (GitHub Actions, Vercel)
# use the session pooler instead: same host/user as DATABASE_URL, but port 5432.
DIRECT_DATABASE_URL=

# ── Storage (Supabase Storage via its S3-compatible API, server-side only) ──
# Supabase dashboard → Storage → S3 Connection: endpoint, region, and "New access key".
# These keys can read/write every bucket: keep them secret, never expose to the frontend.
# Moving to Cloudflare R2 later = change these four values, no code changes.
STORAGE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_BUCKET=hub-files

# ── Auth (Better Auth) ───────────────────────────────
# 32+ random characters: openssl rand -base64 32. Changing it signs everyone out.
AUTH_SECRET=
# Public URL of this API (used for auth callbacks and links)
API_URL=http://localhost:4000
# Public URL of the Hub web app (links inside emails)
APP_URL=http://localhost:5173
# Only these email domains can sign up (comma-separated). Invitations only set the role (admin/ops/guest).
AUTH_ALLOWED_DOMAINS=linchpin.net
# Used by `npm run db:seed` (or `npm run db:seed -- --only=dev`): these people get a role when they sign up.
# Comma-separated; quotes are fine: "a@x.com", "b@y.com"
SEED_ADMIN_EMAILS=
SEED_OPS_EMAILS=
# Developers: get the admin role (like DEV_ADMIN_EMAILS in today's Hub)
SEED_DEV_EMAILS=

# ── Email (SMTP; Hostinger defaults) ─────────────────
# To start sending: fill SMTP_USER + SMTP_PASS (+ MAIL_FROM) and set MAIL_MODE=live. No code changes.
# Hostinger: SMTP_HOST=smtp.hostinger.com, port 465 (SSL) or 587 (STARTTLS); user = full mailbox address.
# Other providers work too (Google Workspace: smtp.gmail.com + app password; Resend/Postmark: their SMTP host).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# true = SSL from the start (465), false = STARTTLS (587). Leave empty to decide from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Defaults to "SpaceMatch Hub <SMTP_USER>". Must be the mailbox or an alias it may send as.
MAIL_FROM="SpaceMatch Hub <hub@spacematchinc.com>"
MAIL_REPLY_TO=
# off = write emails to the log instead of sending (codes visible in dev logs). live = send via SMTP.
MAIL_MODE=off

# Copy to .env and fill in. Never commit .env.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ── Database (Supabase Postgres) ─────────────────────
# Pooled connection, transaction mode (port 6543): used by the API at runtime
DATABASE_URL=
# Direct connection (port 5432): used only for migrations and backups.
# db.<project>.supabase.co is IPv6-only. On IPv4-only networks (GitHub Actions, Vercel)
# use the session pooler instead: same host/user as DATABASE_URL, but port 5432.
DIRECT_DATABASE_URL=

# ── Storage (Supabase Storage via its S3-compatible API, server-side only) ──
# Supabase dashboard → Storage → S3 Connection: endpoint, region, and "New access key".
# These keys can read/write every bucket: keep them secret, never expose to the frontend.
# Moving to Cloudflare R2 later = change these four values, no code changes.
STORAGE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_BUCKET=hub-files

# ── Auth (Better Auth) ───────────────────────────────
# 32+ random characters: openssl rand -base64 32. Changing it signs everyone out.
AUTH_SECRET=
# Public URL of this API (used for auth callbacks and links)
API_URL=http://localhost:4000
# Public URL of the Hub web app (links inside emails)
APP_URL=http://localhost:5173
# Only these email domains can sign up (comma-separated). Invitations only set the role (admin/ops/guest).
AUTH_ALLOWED_DOMAINS=linchpin.net
# Used by `npm run db:seed` (or `npm run db:seed -- --only=dev`): these people get a role when they sign up.
# Comma-separated; quotes are fine: "a@x.com", "b@y.com"
SEED_ADMIN_EMAILS=
SEED_OPS_EMAILS=
# Developers: get the admin role (like DEV_ADMIN_EMAILS in today's Hub)
SEED_DEV_EMAILS=

# ── Email (SMTP; Hostinger defaults) ─────────────────
# To start sending: fill SMTP_USER + SMTP_PASS (+ MAIL_FROM) and set MAIL_MODE=live. No code changes.
# Hostinger: SMTP_HOST=smtp.hostinger.com, port 465 (SSL) or 587 (STARTTLS); user = full mailbox address.
# Other providers work too (Google Workspace: smtp.gmail.com + app password; Resend/Postmark: their SMTP host).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# true = SSL from the start (465), false = STARTTLS (587). Leave empty to decide from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Defaults to "SpaceMatch Hub <SMTP_USER>". Must be the mailbox or an alias it may send as.
MAIL_FROM="SpaceMatch Hub <hub@spacematchinc.com>"
MAIL_REPLY_TO=
# off = write emails to the log instead of sending (codes visible in dev logs). live = send via SMTP.
MAIL_MODE=off

# ── SpaceMatch Reels service (social video views) ────
# Weekly numbers "Fetch" reads Instagram / YouTube / TikTok / Facebook views through it.
# Optional: sent as "Authorization: Bearer …" only when set. The live service's /v1 API requires one
# (Reels dashboard → API keys → Create key, keep all scopes). Server-side only.
REELS_API_URL=https://spacematch-backend.vercel.app/v1
REELS_API_KEY=

# ── Web Push (announcements, open houses, client notes) ──
# Generate once with: npx web-push generate-vapid-keys   (keep the private key secret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@spacematchinc.com

# ── Lofty CRM, READ-ONLY (finds each listing's seller among the team's Lofty leads; never writes) ──
# Lofty → Settings → Integrations → API → generate key (team admin).
LOFTY_API_KEY=
LOFTY_API_URL=https://api.lofty.com

# ── YouTube Data API v3 (auto-find each listing's Short on the brokerage channel) ──
# Google Cloud console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=
# Uploads playlist of @spacematchinc (channel id with "UC" → "UU")
YOUTUBE_UPLOADS_PLAYLIST=UUg4SCyhsx-9tsHUBrHNuxsA

# ── Scheduled jobs (Vercel Cron) ─────────────────────
# Long random string. Vercel Cron sends it as "Authorization: Bearer …" to /api/v1/cron/*.
# Required in production; locally the cron endpoints work without it.
CRON_SECRET=

# ── CMA builder ──────────────────────────────────────
# Long random string shared with the CMA builder (sent as "x-worker-key" to /api/v1/cma-worker/*).
# Empty = the worker routes are switched off.
CMA_WORKER_KEY=

# ── CMA Builder (listing CMAs; see CMA_BUILDER.md) ──
# Browser sources the broker has confirmed may be automated (comma-separated adapter IDs).
# Leave empty until that is confirmed in writing: credentials alone never switch a source on.
CMA_BROWSER_AUTHORIZED_SOURCES=
# MRED is paused and unavailable in CMA Builder.
# CMA_MRED_USERNAME=
# CMA_MRED_PASSWORD=
# Worker only: parallel browser jobs (1–4), per-job timeout, optional Chromium binary path.
CMA_BROWSER_CONCURRENCY=1
CMA_BROWSER_TIMEOUT_MS=180000
CMA_BROWSER_EXECUTABLE=
# RentCast property API (free developer tier: 50 calls/month). Empty = not offered.
RENTCAST_API_KEY=
# true = offer the clearly labelled local fixture source for testing (ignored in production).
# PDF/PowerPoint exports: inline = rendered by the API on request (Vercel); worker = by `npm run worker`
CMA_EXPORT_MODE=inline
CMA_DEV_FIXTURES=false
# Weekly refresh emails the agent when the estimate moves at least this many percent.
CMA_REFRESH_THRESHOLD_PCT=3
CMA_WORKER_POLL_MS=5000
# Python with cma-export/requirements.txt installed (worker only). Defaults to .venv/bin/python when present, then python3.
# CMA_EXPORT_PYTHON=/path/to/cma-export-venv/bin/python

# Reuse complete listing-address property research for seven days (0 disables reuse).
CMA_PROPERTY_RESEARCH_CACHE_HOURS=168

# Google OAuth for Email seller (OAuth Web application credentials).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Defaults to APP_URL + /api/v1/google-mail/callback
GOOGLE_OAUTH_REDIRECT_URI=
